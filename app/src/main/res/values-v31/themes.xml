<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) specific theme to hide system splash icon -->
<resources>
    <style name="Theme.Inka" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Hide the Android 12+ automatic splash screen icon -->
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
